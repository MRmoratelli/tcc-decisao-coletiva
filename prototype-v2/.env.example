# Exclusivamente no backend. Nunca usar nomes VITE_* para segredos.
# Provisione uma base/branch Neon NOVA e isolada. Não reutilize credenciais históricas.
DATABASE_URL_V2=postgresql://dc2_app:SENHA_NOVA@HOST_POOLER:5432/decisao_v2?sslmode=verify-full
DATABASE_URL_V2_DIRECT=postgresql://dc2_owner:SENHA_NOVA@HOST_DIRETO:5432/decisao_v2?sslmode=verify-full
V2_DATABASE_ISOLATED=false
GEMINI_API_KEY=
# Configure um modelo efetivamente disponível na sua conta. Integração real ainda deve ser verificada.
GEMINI_MODEL=gemini-3.5-flash-lite
AUTH_PEPPER=
REVIEW_SIGNING_KEY=
API_PORT=8787
API_HOST=127.0.0.1
# Em hospedagem remota: origem HTTPS pública exata, com proxy /api na mesma origem.
PUBLIC_ORIGIN=

# Verificador explícito: somente dados sintéticos e chave nova autorizada.
ALLOW_LIVE_GEMINI_TEST=false
SERVE_FRONTEND=false

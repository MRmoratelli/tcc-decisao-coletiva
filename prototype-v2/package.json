{
  "name": "decisao-coletiva-v2",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json && vite build",
    "test": "node --import tsx --test server/*.test.ts src/*.test.tsx",
    "start:api": "tsx server/index.ts",
    "migrate": "tsx server/migrate.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "report:cohort": "tsx server/cohort.ts"
  },
  "dependencies": {
    "@google/genai": "^1.0.0",
    "dotenv": "^16.4.5",
    "express": "^5.1.0",
    "pg": "^8.15.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.19.0",
    "typescript": "~5.9.0",
    "vite": "^8.0.0",
    "@electric-sql/pglite": "^0.3.0",
    "react-test-renderer": "^19.0.0",
    "@types/react-test-renderer": "^19.0.0"
  }
}

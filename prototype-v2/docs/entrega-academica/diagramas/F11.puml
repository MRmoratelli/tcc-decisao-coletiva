@startuml
skinparam defaultFontSize 14
skinparam shadowing false
start
:Criar proposta e sala;
:Participantes ingressam;
while (Processo OPEN?) is (sim)
:Consultar proposta e registrar votos;
if (Todos ACEITO?) then (sim)
:Registrar CONSENSUS;
else (nao)
:Examinar manifestacoes;
if (Encerrar sem consenso?) then (sim)
:Informar razao;
:Registrar CLOSED_WITHOUT_CONSENSUS;
else (nao)
:Preparar analise/sintese ou revisao manual;
:Moderador examina e publica nova rodada;
endif
endif
endwhile (nao)
stop
@enduml
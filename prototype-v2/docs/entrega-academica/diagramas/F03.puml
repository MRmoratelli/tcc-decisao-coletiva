@startuml
skinparam defaultFontSize 14
skinparam shadowing false
skinparam backgroundColor white
actor Moderador as M
actor Participante as P
rectangle "Sistema de decisao coletiva" as S
cloud Gemini as G
cloud Tavily as T
database "PostgreSQL / Neon" as DB
M --> S : propostas e revisoes
